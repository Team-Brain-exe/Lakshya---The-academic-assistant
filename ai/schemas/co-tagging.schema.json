{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "co-tagging.schema.json",
  "title": "CO tagging output",
  "type": "object",
  "required": ["tags"],
  "additionalProperties": false,
  "properties": {
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "cos", "confidence"],
        "additionalProperties": false,
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "cos": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
