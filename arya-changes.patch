diff -ruN -x __pycache__ -x node_modules -x '*.pyc' -x .pytest_cache a/backend/app/pg/analytics.py ./backend/app/pg/analytics.py
--- a/backend/app/pg/analytics.py	1970-01-01 00:00:00.000000000 +0000
+++ ./backend/app/pg/analytics.py	2026-10-25 10:00:08.529958042 +0000
@@ -0,0 +1,178 @@
+"""AnalyticsStore on Postgres: roster, CO config and per-attempt CO scores.
+
+Reads student_co_scores (written by Aparna's submit) and rebuilds one AttemptScore per
+graded attempt. The attempt rule (best, latest or average) is applied in code by
+co_analytics through ATTEMPT_RULE, the same setting Aparna's submit uses to set the
+`counted` flag, so the sheet and the flag agree. Per-question results (needed only for
+the drill-down) are rebuilt by re-grading the stored answers with engine.grading.
+"""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from typing import Any
+
+from sqlalchemy import text
+
+from ..engine.co_math import AttemptScore, COConfig, StudentInfo
+from ..engine.grading import COMarks, QuestionKey, grade_attempt
+from .common import as_uuid, to_float
+
+
+class PostgresAnalyticsStore:
+    def __init__(self, conn: Any) -> None:
+        self.conn = conn
+
+    # -- course outcomes -------------------------------------------------
+
+    def get_subject_cos(self, subject_id: str) -> list[COConfig]:
+        rows = self.conn.execute(
+            text(
+                "SELECT number, threshold_pct, target_attainment_pct "
+                "FROM course_outcomes WHERE subject_id = :sid ORDER BY number"
+            ),
+            {"sid": as_uuid(subject_id, "Subject")},
+        ).fetchall()
+        return [COConfig(int(r[0]), float(r[1]), float(r[2])) for r in rows]
+
+    def get_co_by_id(self, co_id: str) -> COConfig | None:
+        row = self.conn.execute(
+            text(
+                "SELECT number, threshold_pct, target_attainment_pct "
+                "FROM course_outcomes WHERE id = :id"
+            ),
+            {"id": as_uuid(co_id, "Course outcome")},
+        ).fetchone()
+        return COConfig(int(row[0]), float(row[1]), float(row[2])) if row else None
+
+    def co_numbers_to_ids(self, subject_id: str) -> dict[int, str]:
+        rows = self.conn.execute(
+            text("SELECT number, id FROM course_outcomes WHERE subject_id = :sid"),
+            {"sid": as_uuid(subject_id, "Subject")},
+        ).fetchall()
+        return {int(r[0]): str(r[1]) for r in rows}
+
+    # -- people ----------------------------------------------------------
+
+    def get_subject_roster(self, subject_id: str) -> list[StudentInfo]:
+        rows = self.conn.execute(
+            text(
+                "SELECT s.usn, s.name, e.section FROM enrollments e "
+                "JOIN students s ON s.id = e.student_id "
+                "WHERE e.subject_id = :sid ORDER BY s.usn"
+            ),
+            {"sid": as_uuid(subject_id, "Subject")},
+        ).fetchall()
+        return [StudentInfo(usn=r[0], name=r[1], section=r[2]) for r in rows]
+
+    def get_student_by_usn(self, usn: str) -> StudentInfo | None:
+        row = self.conn.execute(
+            text(
+                "SELECT s.usn, s.name, "
+                "(SELECT e.section FROM enrollments e WHERE e.student_id = s.id LIMIT 1) "
+                "FROM students s WHERE s.usn = :usn"
+            ),
+            {"usn": usn.strip().upper()},
+        ).fetchone()
+        return StudentInfo(usn=row[0], name=row[1], section=row[2]) if row else None
+
+    # -- scores ----------------------------------------------------------
+
+    def get_subject_attempts(self, subject_id: str) -> list[AttemptScore]:
+        sid = as_uuid(subject_id, "Subject")
+        rows = self.conn.execute(
+            text(
+                "SELECT s.attempt_id, st.usn, a.quiz_id, a.attempt_number, a.answers, "
+                "       COALESCE(s.module_id, z.module_id) AS module_id, "
+                "       c.number AS co_number, s.marks_obtained, s.max_marks "
+                "FROM student_co_scores s "
+                "JOIN quiz_attempts a ON a.id = s.attempt_id "
+                "JOIN quizzes z ON z.id = a.quiz_id "
+                "JOIN students st ON st.id = s.student_id "
+                "JOIN course_outcomes c ON c.id = s.co_id "
+                "WHERE s.subject_id = :sid AND a.submitted_at IS NOT NULL "
+                "ORDER BY st.usn, a.quiz_id, a.attempt_number, c.number"
+            ),
+            {"sid": sid},
+        ).mappings().fetchall()
+        if not rows:
+            return []
+
+        quiz_ids = sorted({str(r["quiz_id"]) for r in rows})
+        keys_by_quiz = self._question_keys(quiz_ids)
+
+        grouped: dict[str, dict[str, Any]] = {}
+        per_co: dict[str, dict[int, COMarks]] = defaultdict(dict)
+        for r in rows:
+            aid = str(r["attempt_id"])
+            grouped.setdefault(aid, r)
+            co = int(r["co_number"])
+            per_co[aid][co] = COMarks(co=co, obtained=float(r["marks_obtained"]), maximum=float(r["max_marks"]))
+
+        out: list[AttemptScore] = []
+        for aid, r in grouped.items():
+            quiz_id = str(r["quiz_id"])
+            answers = r["answers"] or {}
+            questions: tuple = ()
+            keys = keys_by_quiz.get(quiz_id)
+            if keys:
+                try:
+                    questions = grade_attempt(keys, answers).questions
+                except ValueError:
+                    questions = ()
+            out.append(
+                AttemptScore(
+                    usn=r["usn"],
+                    quiz_id=quiz_id,
+                    module_id=str(r["module_id"]) if r["module_id"] else "unknown",
+                    attempt_number=int(r["attempt_number"]),
+                    per_co=per_co[aid],
+                    questions=questions,
+                )
+            )
+        return out
+
+    def _question_keys(self, quiz_ids: list[str]) -> dict[str, list[QuestionKey]]:
+        if not quiz_ids:
+            return {}
+        rows = self.conn.execute(
+            text(
+                "SELECT qq.quiz_id, q.id, c.number, q.correct_option, q.marks "
+                "FROM quiz_questions qq "
+                "JOIN questions q ON q.id = qq.question_id "
+                "JOIN course_outcomes c ON c.id = q.co_id "
+                "WHERE qq.quiz_id = ANY(CAST(:ids AS uuid[])) "
+                "ORDER BY qq.quiz_id, qq.position"
+            ),
+            {"ids": "{" + ",".join(quiz_ids) + "}"},
+        ).fetchall()
+        keys: dict[str, list[QuestionKey]] = defaultdict(list)
+        for quiz_id, qid, co, correct, marks in rows:
+            keys[str(quiz_id)].append(
+                QuestionKey(id=str(qid), co=int(co), correct_option=int(correct), marks=float(marks))
+            )
+        return dict(keys)
+
+    def get_student_progress(self, student_id: str, subject_id: str) -> dict[str, Any]:
+        rows = self.conn.execute(
+            text(
+                "SELECT a.quiz_id, a.attempt_number, a.total_score, a.max_score, a.submitted_at "
+                "FROM quiz_attempts a JOIN quizzes z ON z.id = a.quiz_id "
+                "WHERE a.student_id = :stid AND z.subject_id = :sid AND a.submitted_at IS NOT NULL "
+                "ORDER BY a.submitted_at"
+            ),
+            {"stid": as_uuid(student_id, "Student"), "sid": as_uuid(subject_id, "Subject")},
+        ).fetchall()
+        return {
+            "co_scores": [],
+            "attempts": [
+                {
+                    "quiz_id": str(r[0]),
+                    "attempt_number": int(r[1]),
+                    "total_score": to_float(r[2]),
+                    "max_score": to_float(r[3]),
+                    "submitted_at": r[4].isoformat() if r[4] else None,
+                }
+                for r in rows
+            ],
+        }
diff -ruN -x __pycache__ -x node_modules -x '*.pyc' -x .pytest_cache a/backend/app/pg/calendar.py ./backend/app/pg/calendar.py
--- a/backend/app/pg/calendar.py	1970-01-01 00:00:00.000000000 +0000
+++ ./backend/app/pg/calendar.py	2026-10-25 10:00:36.182986394 +0000
@@ -0,0 +1,110 @@
+"""CalendarStore on Postgres (events table)."""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any, Sequence
+
+from sqlalchemy import text
+
+from ..services.calendar import CalendarEvent
+from .common import as_uuid, to_str
+
+_COLS = (
+    "id, subject_id, section, type, title, starts_at, ends_at, quiz_id, module_id, "
+    "created_by, created_by_agent, created_at"
+)
+_UPDATABLE = {"section", "type", "title", "starts_at", "ends_at", "quiz_id", "module_id"}
+
+
+def _row_to_event(r: Any) -> CalendarEvent:
+    return CalendarEvent(
+        id=str(r["id"]),
+        subject_id=str(r["subject_id"]),
+        type=r["type"],
+        title=r["title"],
+        starts_at=r["starts_at"],
+        ends_at=r["ends_at"],
+        section=r["section"],
+        quiz_id=to_str(r["quiz_id"]),
+        module_id=to_str(r["module_id"]),
+        created_by=to_str(r["created_by"]),
+        created_by_agent=bool(r["created_by_agent"]),
+        created_at=r["created_at"],
+    )
+
+
+class PostgresCalendarStore:
+    def __init__(self, conn: Any) -> None:
+        self.conn = conn
+
+    def save_event(self, event: CalendarEvent) -> CalendarEvent:
+        row = self.conn.execute(
+            text(
+                "INSERT INTO events (subject_id, section, type, title, starts_at, ends_at, "
+                "quiz_id, module_id, created_by, created_by_agent) "
+                "VALUES (:sub, :sec, :type, :title, :start, :end, :quiz, :mod, :by, :agent) "
+                f"RETURNING {_COLS}"
+            ),
+            {
+                "sub": as_uuid(event.subject_id, "Subject"),
+                "sec": event.section,
+                "type": event.type,
+                "title": event.title,
+                "start": event.starts_at,
+                "end": event.ends_at,
+                "quiz": as_uuid(event.quiz_id, "Quiz") if event.quiz_id else None,
+                "mod": as_uuid(event.module_id, "Module") if event.module_id else None,
+                "by": event.created_by,
+                "agent": event.created_by_agent,
+            },
+        ).mappings().fetchone()
+        return _row_to_event(row)
+
+    def get_event(self, event_id: str) -> CalendarEvent | None:
+        row = self.conn.execute(
+            text(f"SELECT {_COLS} FROM events WHERE id = :id"), {"id": as_uuid(event_id, "Event")}
+        ).mappings().fetchone()
+        return _row_to_event(row) if row else None
+
+    def update_event(self, event_id: str, updates: dict[str, Any]) -> CalendarEvent | None:
+        fields = {k: v for k, v in updates.items() if k in _UPDATABLE}
+        if not fields:
+            return self.get_event(event_id)
+        sets = ", ".join(f"{k} = :{k}" for k in fields)
+        params = dict(fields)
+        params["id"] = as_uuid(event_id, "Event")
+        row = self.conn.execute(
+            text(f"UPDATE events SET {sets} WHERE id = :id RETURNING {_COLS}"), params
+        ).mappings().fetchone()
+        return _row_to_event(row) if row else None
+
+    def delete_event(self, event_id: str) -> bool:
+        result = self.conn.execute(
+            text("DELETE FROM events WHERE id = :id"), {"id": as_uuid(event_id, "Event")}
+        )
+        return result.rowcount > 0
+
+    def list_events(
+        self,
+        subject_ids: Sequence[str] | None = None,
+        from_time: datetime | None = None,
+        to_time: datetime | None = None,
+    ) -> list[CalendarEvent]:
+        where, params = [], {}
+        if subject_ids is not None:
+            if not subject_ids:
+                return []
+            where.append("subject_id = ANY(CAST(:subs AS uuid[]))")
+            params["subs"] = "{" + ",".join(as_uuid(s, "Subject") for s in subject_ids) + "}"
+        if from_time is not None:
+            where.append("starts_at >= :from_t")
+            params["from_t"] = from_time
+        if to_time is not None:
+            where.append("starts_at <= :to_t")
+            params["to_t"] = to_time
+        clause = (" WHERE " + " AND ".join(where)) if where else ""
+        rows = self.conn.execute(
+            text(f"SELECT {_COLS} FROM events{clause} ORDER BY starts_at"), params
+        ).mappings().fetchall()
+        return [_row_to_event(r) for r in rows]
diff -ruN -x __pycache__ -x node_modules -x '*.pyc' -x .pytest_cache a/backend/app/pg/chunks.py ./backend/app/pg/chunks.py
--- a/backend/app/pg/chunks.py	1970-01-01 00:00:00.000000000 +0000
+++ ./backend/app/pg/chunks.py	2026-10-25 10:00:36.182032010 +0000
@@ -0,0 +1,229 @@
+"""ChunkStore on Postgres: the storage side of the slide-upload pipeline.
+
+Also holds the read queries that the coverage endpoint, slide retrieval and the study
+features share, so they all see the same chunks and CO links.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Sequence
+
+from sqlalchemy import text
+
+from ..pipeline.ppt import SlideChunk
+from ..pipeline.upload import StoredChunk, TagResult
+from ..services.qa import InMemoryChunkRetrievalStore, RetrievalChunk
+from .common import as_uuid
+
+
+class PostgresChunkStore:
+    """Implements pipeline.upload.ChunkStore for one subject.
+
+    commit_status=True commits every status change, so a client polling
+    GET /modules/{id}/status sees `processing` while the work is still running.
+    """
+
+    def __init__(self, conn: Any, subject_id: str, *, commit_status: bool = False) -> None:
+        self.conn = conn
+        self.subject_id = as_uuid(subject_id, "Subject")
+        self.commit_status = commit_status
+        self._co_ids: dict[int, str] | None = None
+
+    # -- ChunkStore protocol --------------------------------------------
+
+    def set_module_status(self, module_id: str, status: str, error: str | None = None) -> None:
+        self.conn.execute(
+            text(
+                "UPDATE modules SET processing_status = :st, processing_error = :err, "
+                "processed_at = CASE WHEN :st IN ('done', 'failed') THEN now() ELSE NULL END "
+                "WHERE id = :id"
+            ),
+            {"st": status, "err": error, "id": as_uuid(module_id, "Module")},
+        )
+        if self.commit_status:
+            self.conn.commit()
+
+    def save_chunks(self, module_id: str, chunks: Sequence[SlideChunk]) -> list[StoredChunk]:
+        mid = as_uuid(module_id, "Module")
+        # A re-upload replaces the old slides (chunk_cos rows go with them).
+        self.conn.execute(text("DELETE FROM content_chunks WHERE module_id = :m"), {"m": mid})
+        saved: list[StoredChunk] = []
+        for c in chunks:
+            new_id = self.conn.execute(
+                text(
+                    "INSERT INTO content_chunks (module_id, slide_number, text, tag_status) "
+                    "VALUES (:m, :n, :t, 'untagged') RETURNING id"
+                ),
+                {"m": mid, "n": c.slide_number, "t": c.text},
+            ).scalar_one()
+            saved.append(StoredChunk(id=str(new_id), slide_number=c.slide_number, text=c.text))
+        return saved
+
+    def save_tags(self, tags: Sequence[TagResult]) -> None:
+        co_ids = self._co_id_map()
+        for t in tags:
+            linked = False
+            for number in t.cos:
+                co_id = co_ids.get(number)
+                if co_id is None:
+                    continue
+                self.conn.execute(
+                    text(
+                        "INSERT INTO chunk_cos (chunk_id, co_id, confidence) VALUES (:ch, :co, :cf) "
+                        "ON CONFLICT (chunk_id, co_id) DO UPDATE SET confidence = EXCLUDED.confidence"
+                    ),
+                    {"ch": as_uuid(t.chunk_id), "co": co_id, "cf": t.confidence},
+                )
+                linked = True
+            if linked:
+                self.conn.execute(
+                    text("UPDATE content_chunks SET tag_status = 'tagged' WHERE id = :id"),
+                    {"id": as_uuid(t.chunk_id)},
+                )
+
+    def mark_untagged(self, chunk_ids: Sequence[str]) -> None:
+        for cid in chunk_ids:
+            self.conn.execute(
+                text("UPDATE content_chunks SET tag_status = 'untagged' WHERE id = :id"),
+                {"id": as_uuid(cid)},
+            )
+
+    # -- helpers ---------------------------------------------------------
+
+    def _co_id_map(self) -> dict[int, str]:
+        if self._co_ids is None:
+            rows = self.conn.execute(
+                text("SELECT number, id FROM course_outcomes WHERE subject_id = :s"),
+                {"s": self.subject_id},
+            ).fetchall()
+            self._co_ids = {int(r[0]): str(r[1]) for r in rows}
+        return self._co_ids
+
+
+# ---------------------------------------------------------------------------
+# Read queries
+# ---------------------------------------------------------------------------
+
+def module_status(conn: Any, module_id: str) -> dict[str, Any] | None:
+    mid = as_uuid(module_id, "Module")
+    row = conn.execute(
+        text(
+            "SELECT m.processing_status, m.processing_error, "
+            "  (SELECT count(*) FROM content_chunks c WHERE c.module_id = m.id) AS total, "
+            "  (SELECT count(*) FROM content_chunks c WHERE c.module_id = m.id AND c.tag_status = 'tagged') AS tagged "
+            "FROM modules m WHERE m.id = :id"
+        ),
+        {"id": mid},
+    ).mappings().fetchone()
+    if row is None:
+        return None
+    return {
+        "processing_status": row["processing_status"],
+        "chunks_total": int(row["total"]),
+        "chunks_tagged": int(row["tagged"]),
+        "chunks_untagged": int(row["total"]) - int(row["tagged"]),
+        "error": row["processing_error"],
+    }
+
+
+def subject_cos(conn: Any, subject_id: str) -> list[dict[str, Any]]:
+    rows = conn.execute(
+        text(
+            "SELECT id, number, description, threshold_pct FROM course_outcomes "
+            "WHERE subject_id = :s ORDER BY number"
+        ),
+        {"s": as_uuid(subject_id, "Subject")},
+    ).mappings().fetchall()
+    return [
+        {
+            "id": str(r["id"]),
+            "number": int(r["number"]),
+            "description": r["description"],
+            "threshold_pct": float(r["threshold_pct"]),
+        }
+        for r in rows
+    ]
+
+
+def chunk_co_links(conn: Any, subject_id: str) -> list[tuple[str, int]]:
+    """(chunk_id, co_number) for every tagged chunk of a subject."""
+    rows = conn.execute(
+        text(
+            "SELECT cc.chunk_id, co.number FROM chunk_cos cc "
+            "JOIN course_outcomes co ON co.id = cc.co_id "
+            "JOIN content_chunks ch ON ch.id = cc.chunk_id "
+            "JOIN modules m ON m.id = ch.module_id "
+            "WHERE m.subject_id = :s"
+        ),
+        {"s": as_uuid(subject_id, "Subject")},
+    ).fetchall()
+    return [(str(r[0]), int(r[1])) for r in rows]
+
+
+def slide_chunks_for_subject(conn: Any, subject_id: str) -> list[dict[str, Any]]:
+    """One dict per (chunk, CO) link: what the study plan needs to link slides to a CO."""
+    rows = conn.execute(
+        text(
+            "SELECT ch.id, ch.module_id, ch.slide_number, ch.text, co.number "
+            "FROM chunk_cos cc "
+            "JOIN content_chunks ch ON ch.id = cc.chunk_id "
+            "JOIN modules m ON m.id = ch.module_id "
+            "JOIN course_outcomes co ON co.id = cc.co_id "
+            "WHERE m.subject_id = :s ORDER BY co.number, cc.confidence DESC NULLS LAST, m.number, ch.slide_number"
+        ),
+        {"s": as_uuid(subject_id, "Subject")},
+    ).fetchall()
+    return [
+        {
+            "chunk_id": str(r[0]),
+            "module_id": str(r[1]),
+            "slide_number": int(r[2]),
+            "text": r[3],
+            "co_number": int(r[4]),
+        }
+        for r in rows
+    ]
+
+
+def module_chunks_with_co(conn: Any, module_id: str) -> list[dict[str, Any]]:
+    """Chunks of one module, each with its best-matching CO id (None if untagged)."""
+    rows = conn.execute(
+        text(
+            "SELECT ch.id, ch.slide_number, ch.text, "
+            "  (SELECT cc.co_id FROM chunk_cos cc WHERE cc.chunk_id = ch.id "
+            "   ORDER BY cc.confidence DESC NULLS LAST LIMIT 1) AS co_id "
+            "FROM content_chunks ch WHERE ch.module_id = :m ORDER BY ch.slide_number"
+        ),
+        {"m": as_uuid(module_id, "Module")},
+    ).fetchall()
+    return [
+        {"chunk_id": str(r[0]), "slide_number": int(r[1]), "text": r[2], "co_id": str(r[3]) if r[3] else None}
+        for r in rows
+    ]
+
+
+class PostgresChunkRetrievalStore:
+    """Slide search for Q&A.
+
+    Decision (see docs/decisions.md #1): no embeddings. The corpus is a few hundred
+    short chunks per subject, so the subject's chunks are loaded and scored with the
+    keyword scorer in services/qa. No extension, no extra model, nothing to re-embed
+    when the server restarts.
+    """
+
+    def __init__(self, conn: Any) -> None:
+        self.conn = conn
+
+    def search_chunks(self, subject_id: str, query: str, top_k: int = 3) -> list[RetrievalChunk]:
+        rows = self.conn.execute(
+            text(
+                "SELECT ch.id, ch.module_id, ch.slide_number, ch.text "
+                "FROM content_chunks ch JOIN modules m ON m.id = ch.module_id "
+                "WHERE m.subject_id = :s"
+            ),
+            {"s": as_uuid(subject_id, "Subject")},
+        ).fetchall()
+        index = InMemoryChunkRetrievalStore()
+        for cid, mid, slide, body in rows:
+            index.add_chunk(subject_id, str(cid), str(mid), int(slide), body)
+        return index.search_chunks(subject_id, query, top_k=top_k)
