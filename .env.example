# Copy to .env and fill in. NEVER commit real values.

# --- Nebius Token Factory (all AI calls) ---
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=
# Model IDs are chosen after Danwin's model test (task 1). Fill from ai/config.
MODEL_TAGGING=
MODEL_GENERATION=
MODEL_AGENT=
MODEL_REASONING=

# --- Supabase / Postgres ---
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# --- App ---
SESSION_SECRET=
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Grading config (see docs/decisions.md) ---
# best | latest | average : which attempt counts when a student attempts twice
ATTEMPT_RULE=best
MAX_ATTEMPTS=2
